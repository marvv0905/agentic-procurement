# Copy to .env and fill in. Never commit real secrets.

# LLM provider (configurable structured-output/tool-capable provider).
# Exact supported model names must be checked against the pinned SDK version.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Local mock site / portal base URLs (used by the browser tools).
SUPPLIER_A_URL=http://127.0.0.1:8101
SUPPLIER_B_URL=http://127.0.0.1:8102
SUPPLIER_C_URL=http://127.0.0.1:8103
PORTAL_URL=http://127.0.0.1:8200

# SQLite database location (relative to repo root).
DATABASE_URL=sqlite:///data/purchasepilot.db

# Runtime limits (measure real values during the feasibility spike).
MAX_PAGES_PER_RUN=30
MAX_ACTIONS_PER_RUN=200
MAX_TIME_SECONDS_PER_RUN=600
