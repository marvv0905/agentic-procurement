# PurchasePilot environment configuration.
#
# Copy this file to `.env` and fill in real values:
#   cp example.env .env
# Never commit real secrets — `.env` and `.env.local` are gitignored.

# ---- Text LLM (DeepSeek, OpenAI-compatible) — required ----
# Parses free-text requests (chatbot + wizard) and writes decision
# explanations. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Vision LLM (OpenRouter) — recommended ----
# Drives the Stagehand browser agent, so it can read page screenshots, not
# just DOM text. Use a vision-capable model. Without these credentials the
# browser agent falls back to DeepSeek (text-only).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# ---- Database ----
# SQLite location; created and seeded on first run.
DATABASE_URL=sqlite:///data/purchasepilot.db

# ---- Mock supplier sites ----
# Only needed if the mock server (mock_sites/server.py) runs somewhere
# other than localhost:8100.
MOCK_BASE_URL=http://127.0.0.1:8100

# ---- Browser visibility ----
# unset: mock/catalog sites run headless, live aggregator sites open a
#        visible browser window (they sit behind bot protection)
# false: always visible — you can watch the agent shop
# true:  always headless
#STAGEHAND_HEADLESS=

# ---- Seeded admin login ----
# The seeded manager account is admin / admin123 unless overridden here.
#DEMO_ADMIN_PASSWORD=

# ---- Seller-contact routine (optional, Contact Sellers page) ----
# Webhook that drafts a WhatsApp message for approved (PLACED) orders. The
# routine asks the manager for approval before anything is sent, and only
# ever receives the order number — never the order details.
#GROK_WEBHOOK_URL=
#GROK_WEBHOOK_AUTHORIZATION=Bearer your-token
